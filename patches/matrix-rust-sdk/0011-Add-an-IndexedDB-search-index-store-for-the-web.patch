+/// On the web there is no filesystem: a search index "directory" names an
+/// IndexedDB database instead, in which the indexes, kept in memory, save
+/// their files.
+#[cfg(all(feature = "experimental-search", feature = "indexeddb", target_family = "wasm"))]
+async fn open_indexeddb_search_index_store(
+    kind: SearchIndexStoreKind,
+) -> Result<SearchIndexStoreKind, ClientBuildError> {
+    let (path, key) = match kind {
+        SearchIndexStoreKind::UnencryptedDirectory(path) => (path, None),
+        SearchIndexStoreKind::EncryptedDirectory(path, key) => (path, Some(key)),
+        other => return Ok(other),
+    };
+    let store = matrix_sdk_indexeddb::IndexeddbSearchStoreBuilder::with_prefix(
+        &path.to_string_lossy(),
+    )
+    .build()
+    .await
+    .map_err(matrix_sdk_indexeddb::OpenStoreError::from)?;
+    Ok(SearchIndexStoreKind::Store { store: Arc::new(store), key })
+}
+
