+//! An IndexedDB implementation of [`SearchIndexFileStore`]: where the search
+//! indexes, kept in memory in the browser, save their files.
+//!
+//! Files are opaque blobs, already encrypted by the index when it is.
+
+use std::rc::Rc;
+
+use indexed_db_futures::{
+    Build, BuildSerde, KeyRange, database::Database, prelude::QuerySource,
+    transaction::TransactionMode,
+};
+use matrix_sdk_search::store::{
+    IndexFile, IndexFileChanges, SearchIndexFileStore, SearchIndexStoreError,
+};
+use ruma::RoomId;
+use serde::{Deserialize, Serialize};
+use thiserror::Error;
+
+/// The version of the database schema.
+const VERSION: u32 = 1;
+
+mod keys {
+    /// The files of the room indexes, keyed by room id and file name.
+    pub const FILES: &str = "files";
+    /// Values kept alongside the indexes, e.g. markers, keyed by name.
+    pub const VALUES: &str = "values";
+    /// The key path of both object stores.
+    pub const KEY_PATH: &str = "id";
+    /// Separates the room id from the file name in a file's key: a control
+    /// character, which neither contains.
+    pub const SEPARATOR: char = '\u{1f}';
+}
+
+/// A file of a room's index, as stored.
+#[derive(Debug, Serialize, Deserialize)]
+struct FileRecord {
+    /// `<room id><SEPARATOR><file name>`
+    id: String,
+    #[serde(with = "serde_bytes")]
+    data: Vec<u8>,
+}
+
+/// A value kept alongside the indexes, as stored.
+#[derive(Debug, Serialize, Deserialize)]
+struct ValueRecord {
+    id: String,
+    #[serde(with = "serde_bytes")]
+    value: Vec<u8>,
+}
+
+fn file_id(room_id: &RoomId, name: &str) -> String {
+    format!("{room_id}{}{name}", keys::SEPARATOR)
+}
+
+/// The keys of every file of a room's index.
+fn room_files(room_id: &RoomId) -> KeyRange<String> {
+    let prefix = format!("{room_id}{}", keys::SEPARATOR);
+    KeyRange::Bound(prefix.clone(), false, format!("{prefix}\u{ffff}"), false)
+}
+
+/// An error from the [`IndexeddbSearchStore`].
+///
+/// Carries no JavaScript values, so it can be sent across threads like the
+/// other stores' errors.
+#[derive(Debug, Error)]
+pub enum IndexeddbSearchStoreError {
+    /// The database couldn't be opened.
+    #[error("unable to open database: {0}")]
+    UnableToOpenDatabase(String),
+    /// A DOM exception from IndexedDB.
+    #[error("DomException {name} ({code}): {message}")]
+    DomException {
+        /// The exception's name.
+        name: String,
+        /// The exception's message.
+        message: String,
+        /// The exception's code.
+        code: u16,
+    },
+    /// A record couldn't be serialized or deserialized.
+    #[error("serialization: {0}")]
+    Serialization(String),
+    /// Any other error from IndexedDB.
+    #[error("backend: {0}")]
+    Backend(String),
+}
+
+impl From<web_sys::DomException> for IndexeddbSearchStoreError {
+    fn from(value: web_sys::DomException) -> Self {
+        Self::DomException { name: value.name(), message: value.message(), code: value.code() }
+    }
+}
+
+impl From<indexed_db_futures::error::Error> for IndexeddbSearchStoreError {
+    fn from(value: indexed_db_futures::error::Error) -> Self {
+        use indexed_db_futures::error::Error;
+        match value {
+            Error::DomException(e) => web_sys::DomException::from(e).into(),
+            Error::Serialisation(e) => Self::Serialization(e.to_string()),
+            Error::MissingData(e) => Self::Backend(e.to_string()),
+            Error::Unknown(e) => Self::Backend(e.to_string()),
+        }
+    }
+}
+
+impl From<indexed_db_futures::error::SerialisationError> for IndexeddbSearchStoreError {
+    fn from(value: indexed_db_futures::error::SerialisationError) -> Self {
+        Self::Serialization(value.to_string())
+    }
+}
+
+impl From<indexed_db_futures::error::OpenDbError> for IndexeddbSearchStoreError {
+    fn from(value: indexed_db_futures::error::OpenDbError) -> Self {
+        use indexed_db_futures::error::OpenDbError::*;
+        match value {
+            VersionZero | UnsupportedEnvironment | NullFactory => {
+                Self::UnableToOpenDatabase(value.to_string())
+            }
+            Base(e) => e.into(),
+        }
+    }
+}
+
+impl From<IndexeddbSearchStoreError> for SearchIndexStoreError {
+    fn from(value: IndexeddbSearchStoreError) -> Self {
+        SearchIndexStoreError::backend(value)
+    }
+}
+
+/// A type for conveniently building an [`IndexeddbSearchStore`].
+pub struct IndexeddbSearchStoreBuilder {
+    /// The name of the IndexedDB database which will be opened.
+    database_name: String,
+}
+
+impl Default for IndexeddbSearchStoreBuilder {
+    fn default() -> Self {
+        Self { database_name: Self::DEFAULT_DATABASE_NAME.to_owned() }
+    }
+}
+
+impl IndexeddbSearchStoreBuilder {
+    /// The default name of the IndexedDB database used to back the
+    /// [`IndexeddbSearchStore`].
+    pub const DEFAULT_DATABASE_NAME: &'static str = "search";
+
+    /// Create a new [`IndexeddbSearchStoreBuilder`] where the database name is
+    /// constructed by joining the given prefix with
+    /// [`Self::DEFAULT_DATABASE_NAME`] and separated by `::`.
+    pub fn with_prefix(prefix: &str) -> Self {
+        Self { database_name: format!("{}::{}", prefix, Self::DEFAULT_DATABASE_NAME) }
+    }
+
+    /// Sets the name of the IndexedDB database which will be opened. This
+    /// defaults to [`Self::DEFAULT_DATABASE_NAME`].
+    pub fn database_name(mut self, name: String) -> Self {
+        self.database_name = name;
+        self
+    }
+
+    /// Opens the IndexedDB database with the provided name, creating it if
+    /// needed, and builds the [`IndexeddbSearchStore`] with it.
+    pub async fn build(self) -> Result<IndexeddbSearchStore, IndexeddbSearchStoreError> {
+        let database = Database::open(&self.database_name)
+            .with_version(VERSION)
+            .with_on_upgrade_needed(|event, transaction| {
+                if event.old_version() < 1.0 {
+                    let db = transaction.db();
+                    db.create_object_store(keys::FILES)
+                        .with_key_path(keys::KEY_PATH.into())
+                        .build()?;
+                    db.create_object_store(keys::VALUES)
+                        .with_key_path(keys::KEY_PATH.into())
+                        .build()?;
+                }
+                Ok(())
+            })
+            .await?;
+        Ok(IndexeddbSearchStore { inner: Rc::new(database) })
+    }
+}
+
+/// An IndexedDB implementation of [`SearchIndexFileStore`], for the search
+/// indexes in the browser.
+#[derive(Debug, Clone)]
+pub struct IndexeddbSearchStore {
+    /// A handle to the IndexedDB database.
+    inner: Rc<Database>,
+}
+
+impl IndexeddbSearchStore {
+    /// Provides a type with which to conveniently build an
+    /// [`IndexeddbSearchStore`].
+    pub fn builder() -> IndexeddbSearchStoreBuilder {
+        IndexeddbSearchStoreBuilder::default()
+    }
+
+    async fn load_room_files(
+        &self,
+        room_id: &RoomId,
+    ) -> Result<Vec<IndexFile>, IndexeddbSearchStoreError> {
+        let transaction =
+            self.inner.transaction(keys::FILES).with_mode(TransactionMode::Readonly).build()?;
+        let records = transaction
+            .object_store(keys::FILES)?
+            .get_all()
+            .with_query::<String, _>(room_files(room_id))
+            .serde()?
+            .await?
+            .collect::<Result<Vec<FileRecord>, _>>()?;
+
+        let prefix_len = file_id(room_id, "").len();
+        Ok(records
+            .into_iter()
+            .map(|record| IndexFile { name: record.id[prefix_len..].to_owned(), data: record.data })
+            .collect())
+    }
+
+    async fn save_room_files(
+        &self,
+        room_id: &RoomId,
+        changes: IndexFileChanges,
+    ) -> Result<(), IndexeddbSearchStoreError> {
+        let transaction =
+            self.inner.transaction(keys::FILES).with_mode(TransactionMode::Readwrite).build()?;
+        let store = transaction.object_store(keys::FILES)?;
+
+        for name in changes.delete {
+            store.delete::<String, _>(KeyRange::Only(file_id(room_id, &name))).serde()?.await?;
+        }
+        for file in changes.put {
+            store.put(&FileRecord { id: file_id(room_id, &file.name), data: file.data }).serde()?.await?;
+        }
+
+        transaction.commit().await?;
+        Ok(())
+    }
+
+    async fn delete_room_files(&self, room_id: &RoomId) -> Result<(), IndexeddbSearchStoreError> {
+        let transaction =
+            self.inner.transaction(keys::FILES).with_mode(TransactionMode::Readwrite).build()?;
+        transaction
+            .object_store(keys::FILES)?
+            .delete::<String, _>(room_files(room_id))
+            .serde()?
+            .await?;
+        transaction.commit().await?;
+        Ok(())
+    }
+
+    async fn get_stored_value(
+        &self,
+        key: &str,
+    ) -> Result<Option<Vec<u8>>, IndexeddbSearchStoreError> {
+        let transaction =
+            self.inner.transaction(keys::VALUES).with_mode(TransactionMode::Readonly).build()?;
+        let mut records = transaction
+            .object_store(keys::VALUES)?
+            .get_all()
+            .with_query::<String, _>(KeyRange::Only(key.to_owned()))
+            .serde()?
+            .await?
+            .collect::<Result<Vec<ValueRecord>, _>>()?;
+        Ok(records.pop().map(|record| record.value))
+    }
+
+    async fn set_stored_value(
+        &self,
+        key: &str,
+        value: Vec<u8>,
+    ) -> Result<(), IndexeddbSearchStoreError> {
+        let transaction =
+            self.inner.transaction(keys::VALUES).with_mode(TransactionMode::Readwrite).build()?;
+        transaction
+            .object_store(keys::VALUES)?
+            .put(&ValueRecord { id: key.to_owned(), value })
+            .serde()?
+            .await?;
+        transaction.commit().await?;
+        Ok(())
+    }
+}
+
+#[cfg(target_family = "wasm")]
+#[async_trait::async_trait(?Send)]
+impl SearchIndexFileStore for IndexeddbSearchStore {
+    async fn load_room(&self, room_id: &RoomId) -> Result<Vec<IndexFile>, SearchIndexStoreError> {
+        Ok(self.load_room_files(room_id).await?)
+    }
+
+    async fn save_room(
+        &self,
+        room_id: &RoomId,
+        changes: IndexFileChanges,
+    ) -> Result<(), SearchIndexStoreError> {
+        Ok(self.save_room_files(room_id, changes).await?)
+    }
+
+    async fn delete_room(&self, room_id: &RoomId) -> Result<(), SearchIndexStoreError> {
+        Ok(self.delete_room_files(room_id).await?)
+    }
+
+    async fn get_value(&self, key: &str) -> Result<Option<Vec<u8>>, SearchIndexStoreError> {
+        Ok(self.get_stored_value(key).await?)
+    }
+
+    async fn set_value(&self, key: &str, value: Vec<u8>) -> Result<(), SearchIndexStoreError> {
+        Ok(self.set_stored_value(key, value).await?)
+    }
+}
