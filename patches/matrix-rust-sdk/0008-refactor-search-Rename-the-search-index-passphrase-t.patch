From 2dda0d6edd43d9d173df11004b4fe92a40bb55f2 Mon Sep 17 00:00:00 2001
From: Stefan Ceriu <stefanc@matrix.org>
Date: Tue, 13 Oct 2026 16:46:04 +0300
Subject: [PATCH 08/11] refactor(search): Rename the search index passphrase to
 key

It must be a high-entropy key now that it's no longer stretched, so name it after what it is, including in the FFI's ClientBuilder::with_search_index_store.

(cherry picked from commit f3729df055d95dad35ce20864e40433d04c4cafc)
---
 .../changelog.d/7268.changed.md               |  2 +
 bindings/matrix-sdk-ffi/src/client_builder.rs | 10 ++---
 .../changelog.d/7268.changed.md               |  6 +--
 .../src/encrypted/encrypted_dir.rs            | 39 +++++++++----------
 crates/matrix-sdk-search/src/index/builder.rs | 12 +++---
 crates/matrix-sdk-search/src/index/mod.rs     |  8 ++--
 crates/matrix-sdk/src/search_index/mod.rs     | 12 +++---
 7 files changed, 43 insertions(+), 46 deletions(-)
 create mode 100644 bindings/matrix-sdk-ffi/changelog.d/7268.changed.md

diff --git a/bindings/matrix-sdk-ffi/changelog.d/7268.changed.md b/bindings/matrix-sdk-ffi/changelog.d/7268.changed.md
new file mode 100644
index 000000000..12b7aeed5
--- /dev/null
+++ b/bindings/matrix-sdk-ffi/changelog.d/7268.changed.md
@@ -0,0 +1,2 @@
+[**breaking**] `ClientBuilder::with_search_index_store`'s `password` parameter is renamed to `key`: it must be a
+high-entropy key, as it is no longer stretched.
diff --git a/bindings/matrix-sdk-ffi/src/client_builder.rs b/bindings/matrix-sdk-ffi/src/client_builder.rs
index 31fadbb6a..f6a4948f8 100644
--- a/bindings/matrix-sdk-ffi/src/client_builder.rs
+++ b/bindings/matrix-sdk-ffi/src/client_builder.rs
@@ -905,20 +905,20 @@ impl ClientBuilder {
     /// `path` is the directory where the search index will be stored. It must
     /// be unique per session.
     ///
-    /// `password` is an optional password to encrypt the search index at rest.
-    /// If `None`, the search index will be stored unencrypted.
+    /// `key` is an optional high-entropy key to encrypt the search index at
+    /// rest. If `None`, the search index will be stored unencrypted.
     pub fn with_search_index_store(
         self: Arc<Self>,
         path: String,
-        password: Option<String>,
+        key: Option<String>,
     ) -> Arc<Self> {
         let mut builder = unwrap_or_clone_arc(self);
 
         // Note: creation of the path is deferred to later.
         let path = PathBuf::from(path);
 
-        let kind = if let Some(password) = password {
-            SearchIndexStoreKind::EncryptedDirectory(path, password)
+        let kind = if let Some(key) = key {
+            SearchIndexStoreKind::EncryptedDirectory(path, key)
         } else {
             SearchIndexStoreKind::UnencryptedDirectory(path)
         };
diff --git a/crates/matrix-sdk-search/changelog.d/7268.changed.md b/crates/matrix-sdk-search/changelog.d/7268.changed.md
index 97417315f..83fffd555 100644
--- a/crates/matrix-sdk-search/changelog.d/7268.changed.md
+++ b/crates/matrix-sdk-search/changelog.d/7268.changed.md
@@ -1,3 +1,3 @@
-Encrypted room indexes no longer stretch the passphrase with PBKDF2, which made opening each index slow: the
-passphrase must now be a high-entropy key. Existing encrypted indexes, and any index that can't be opened (e.g. after
-a passphrase change), are deleted and recreated.
+Encrypted room indexes no longer stretch their key with PBKDF2, which made opening each index slow: the key, formerly
+called a passphrase, must now be a high-entropy key. Existing encrypted indexes, and any index that can't be opened
+(e.g. after a key change), are deleted and recreated.
diff --git a/crates/matrix-sdk-search/src/encrypted/encrypted_dir.rs b/crates/matrix-sdk-search/src/encrypted/encrypted_dir.rs
index 033d9b7b7..5a947f01c 100644
--- a/crates/matrix-sdk-search/src/encrypted/encrypted_dir.rs
+++ b/crates/matrix-sdk-search/src/encrypted/encrypted_dir.rs
@@ -77,12 +77,12 @@ impl IntoTvError<OpenWriteError> for IoError {
 /// A Directory implementation that wraps a MmapDirectory and adds [AES][aes]
 /// based encryption to the file read/write operations.
 ///
-/// The passphrase must be a high-entropy key: it is expanded, without any key
+/// The key must be a high-entropy key: it is expanded, without any key
 /// stretching, into a 256 bit encryption key and a 256 bit MAC key using
 /// [HKDF][hkdf]:
 ///
 /// ```text
-///     encryption_key, mac_key = HKDF(SHA512, passphrase, "", 512)
+///     encryption_key, mac_key = HKDF(SHA512, key, "", 512)
 /// ```
 ///
 /// Those two keys are used to encrypt and authenticate the Tantivy files, using
@@ -117,27 +117,24 @@ impl EncryptedMmapDirectory {
     /// # Arguments
     ///
     /// - `path` - The path where the directory should reside in.
-    /// - `passphrase` - The high-entropy key used to encrypt the directory.
+    /// - `key` - The high-entropy key used to encrypt the directory.
     ///
-    /// Opening a directory with a different passphrase than the one it was
-    /// created with succeeds, but reading its files will then fail.
-    pub fn open_or_create<P: AsRef<Path>>(
-        path: P,
-        passphrase: &str,
-    ) -> Result<Self, OpenDirectoryError> {
+    /// Opening a directory with a different key than the one it was created
+    /// with succeeds, but reading its files will then fail.
+    pub fn open_or_create<P: AsRef<Path>>(path: P, key: &str) -> Result<Self, OpenDirectoryError> {
         let path = path.as_ref();
 
-        if passphrase.is_empty() {
-            return Err(IoError::other("empty passphrase").into_tv_err(path));
+        if key.is_empty() {
+            return Err(IoError::other("empty key").into_tv_err(path));
         }
 
         create_dir_all(path).map_err(|err| err.into_tv_err(path))?;
 
-        // Expand the passphrase into an encryption and MAC key.
+        // Expand the key into an encryption and MAC key.
         let mut hkdf_result = Zeroizing::new([0u8; KEY_SIZE * 2]);
-        Hkdf::<Sha512>::new(None, passphrase.as_bytes())
+        Hkdf::<Sha512>::new(None, key.as_bytes())
             .expand(&[], &mut *hkdf_result)
-            .map_err(|e| IoError::other(format!("unable to expand the passphrase: {e:?}")))
+            .map_err(|e| IoError::other(format!("unable to expand the key: {e:?}")))
             .map_err(|err| err.into_tv_err(path))?;
         let (encryption_key, mac_key) = hkdf_result.split_at(KEY_SIZE);
 
@@ -283,32 +280,32 @@ mod tests {
         let tmpdir = tempdir().unwrap();
         let file = Path::new("file");
 
-        let dir = EncryptedMmapDirectory::open_or_create(tmpdir.path(), "wordpass")
+        let dir = EncryptedMmapDirectory::open_or_create(tmpdir.path(), "key")
             .expect("Can't create a new store");
         dir.atomic_write(file, b"data").unwrap();
         drop(dir);
 
-        let dir = EncryptedMmapDirectory::open_or_create(tmpdir.path(), "wordpass")
+        let dir = EncryptedMmapDirectory::open_or_create(tmpdir.path(), "key")
             .expect("Can't open the existing store");
         assert_eq!(dir.atomic_read(file).unwrap(), b"data");
         drop(dir);
 
-        let dir = EncryptedMmapDirectory::open_or_create(tmpdir.path(), "password").unwrap();
-        assert!(dir.atomic_read(file).is_err(), "Read a file with the wrong passphrase");
+        let dir = EncryptedMmapDirectory::open_or_create(tmpdir.path(), "another key").unwrap();
+        assert!(dir.atomic_read(file).is_err(), "Read a file with the wrong key");
     }
 
     #[test]
-    fn create_store_with_empty_passphrase() {
+    fn create_store_with_empty_key() {
         let tmpdir = tempdir().unwrap();
         let dir = EncryptedMmapDirectory::open_or_create(tmpdir.path(), "");
-        assert!(dir.is_err(), "Created a store with an empty passphrase");
+        assert!(dir.is_err(), "Created a store with an empty key");
     }
 
     #[test]
     fn create_store_in_nonexistent_directory() {
         let tmpdir = tempdir().unwrap();
         let nested_path = tmpdir.path().join("nested").join("directory");
-        let dir = EncryptedMmapDirectory::open_or_create(&nested_path, "password")
+        let dir = EncryptedMmapDirectory::open_or_create(&nested_path, "key")
             .expect("Should create store in non-existent nested directory");
         drop(dir);
     }
