--- /dev/null
+++ b/crates/matrix-sdk-search/tests/wasm_in_memory.rs
@@ -0,0 +1,129 @@
+//! Smoke test for the in-memory search index on wasm, where tantivy runs
+//! without threads: adds, commits, searches, merges, removes and edits all
+//! have to happen on the calling thread.
+
+#![cfg(target_family = "wasm")]
+
+use matrix_sdk_search::index::{
+    IndexableEvent, RoomIndexOperation, builder::RoomIndexBuilder,
+};
+use ruma::{MilliSecondsSinceUnixEpoch, OwnedEventId, UInt, owned_user_id, room_id};
+use wasm_bindgen_test::wasm_bindgen_test;
+
+fn event_id(n: u64) -> OwnedEventId {
+    format!("$event{n}:example.org").try_into().unwrap()
+}
+
+/// An event whose timestamp grows with `n`, so results come back newest first
+/// in `n` order. The index orders dates with one-second precision, hence a
+/// second per event.
+fn event(n: u64, body: &str) -> IndexableEvent {
+    let ts = MilliSecondsSinceUnixEpoch(UInt::new(1_700_000_000_000 + n * 1000).unwrap());
+    IndexableEvent::new(
+        event_id(n),
+        event_id(n),
+        owned_user_id!("@alice:example.org"),
+        Some(ts),
+        body.to_owned(),
+    )
+}
+
+#[wasm_bindgen_test]
+fn add_search_merge_remove_edit_in_memory() {
+    let mut index = RoomIndexBuilder::new_in_memory(room_id!("!room:example.org")).build();
+
+    // One bulk add, i.e. one commit.
+    let ops = (0..300)
+        .map(|n| {
+            let body =
+                if n % 3 == 0 { format!("hello world {n}") } else { format!("goodbye moon {n}") };
+            RoomIndexOperation::Add(event(n, &body))
+        })
+        .collect();
+    index.bulk_execute(ops).unwrap();
+
+    let result = index.search("hello", 10, None).unwrap();
+    assert_eq!(result.total_count, 100);
+    assert_eq!(result.events.len(), 10);
+    assert_eq!(result.events[0].1, event_id(297), "newest first");
+    assert_eq!(index.search("goodbye", 10, None).unwrap().total_count, 200);
+    assert_eq!(index.search("nothing", 10, None).unwrap().total_count, 0);
+
+    // Many small commits: one new segment each, enough for the merge policy
+    // to kick in, which runs the merges on this thread too.
+    for n in 300..320 {
+        index.execute(RoomIndexOperation::Add(event(n, "hello again"))).unwrap();
+    }
+    assert_eq!(index.search("hello", 10, None).unwrap().total_count, 120);
+    assert_eq!(index.search("again", 50, None).unwrap().total_count, 20);
+    assert_eq!(index.search("hello", 10, None).unwrap().events[0].1, event_id(319));
+
+    // Remove a committed event.
+    index.execute(RoomIndexOperation::Remove(event_id(0))).unwrap();
+    assert_eq!(index.search("hello", 10, None).unwrap().total_count, 119);
+    assert_eq!(index.search("world", 200, None).unwrap().total_count, 99);
+
+    // Edit: the replacement is a new event whose deletion key is the original.
+    let replacement = IndexableEvent::new(
+        event_id(1000),
+        event_id(3),
+        owned_user_id!("@alice:example.org"),
+        Some(MilliSecondsSinceUnixEpoch(UInt::new(1_700_000_000_000 + 3 * 1000).unwrap())),
+        "edited text".to_owned(),
+    );
+    index.execute(RoomIndexOperation::Edit(event_id(3), replacement)).unwrap();
+    assert_eq!(index.search("hello", 10, None).unwrap().total_count, 118);
+    let edited = index.search("edited", 10, None).unwrap();
+    assert_eq!(edited.total_count, 1);
+    assert_eq!(edited.events[0].1, event_id(1000));
+
+    // Removing the original also removes its edit.
+    index.execute(RoomIndexOperation::Remove(event_id(3))).unwrap();
+    assert_eq!(index.search("edited", 10, None).unwrap().total_count, 0);
+
+    // Pagination.
+    let page2 = index.search("goodbye", 10, Some(10)).unwrap();
+    assert_eq!(page2.total_count, 200);
+    assert_eq!(page2.events.len(), 10);
+    assert!(page2.events[0].0 < index.search("goodbye", 10, None).unwrap().events[9].0);
+}
+
+/// Rough timings for the inline (main-thread) indexing path. Run with
+/// `-- --nocapture` to see them.
+#[wasm_bindgen_test]
+fn timings_in_memory() {
+    const WORDS: &[&str] = &[
+        "the", "quick", "brown", "fox", "jumps", "over", "lazy", "dog", "matrix", "search",
+        "index", "message", "room", "hello", "world", "tantivy", "wasm", "browser", "demo",
+    ];
+    let body = |n: u64| -> String {
+        (0..12).map(|i| WORDS[((n * 7 + i * 3) % WORDS.len() as u64) as usize]).collect::<Vec<_>>().join(" ")
+    };
+    let now = || js_sys::Date::now();
+
+    let mut index = RoomIndexBuilder::new_in_memory(room_id!("!perf:example.org")).build();
+
+    let start = now();
+    let ops = (0..5000).map(|n| RoomIndexOperation::Add(event(n, &body(n)))).collect();
+    index.bulk_execute(ops).unwrap();
+    let bulk_ms = now() - start;
+
+    let start = now();
+    for n in 5000..5200 {
+        index.execute(RoomIndexOperation::Add(event(n, &body(n)))).unwrap();
+    }
+    let commits_ms = now() - start;
+
+    let start = now();
+    let result = index.search("quick fox", 20, None).unwrap();
+    let search_ms = now() - start;
+
+    wasm_bindgen_test::console_log!(
+        "TIMINGS bulk 5000 events in one commit: {bulk_ms:.0} ms; 200 single-event commits: \
+         {commits_ms:.0} ms ({:.1} ms each); search over 5200 events: {search_ms:.1} ms \
+         ({} hits)",
+        commits_ms / 200.0,
+        result.total_count
+    );
+    assert!(result.total_count > 0);
+}
