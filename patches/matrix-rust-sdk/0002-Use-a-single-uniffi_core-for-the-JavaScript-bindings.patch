diff --git a/Cargo.toml b/Cargo.toml
index b240ec2b8..b8360cec1 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -254,6 +254,10 @@ async-compat = { git = "https://github.com/element-hq/async-compat", rev = "5a27
 const_panic = { git = "https://github.com/jplatte/const_panic", rev = "e0b317a9a7bde2d48a7d15b6a60d70e4a41d3b5f" }
 # tantivy with a `single-threaded` feature, so the search index works on wasm.
 tantivy = { path = "../tantivy-wasm" }
+# The JavaScript bindings runtime (uniffi-bindgen-react-native) gets uniffi_core
+# from crates.io; this and ruma use a git revision, so point crates.io at it too
+# to end up with a single copy.
+uniffi_core = { git = "https://github.com/mozilla/uniffi-rs.git", rev = "e5f4821410bea19e71984ea5e06a7bc8b11ed9e5" }
 
 [patch."https://github.com/ruma/ruma"]
 # Needed to disable checksums since they're incorrect in 32bit devices.
