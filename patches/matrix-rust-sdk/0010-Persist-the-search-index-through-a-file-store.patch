+//! Encryption of the files of an index: the key derivation and the file
+//! format, shared by the on-disk directory and the persisted in-memory one.
+
+// The encrypted on-disk directory is backed by mmap'd files, which don't
+// exist on wasm.
+#[cfg(not(target_family = "wasm"))]
 pub mod encrypted_dir;
 pub mod encrypted_stream;
+
+use std::{
+    fmt,
+    io::{Cursor, Error as IoError, Read, Result as IoResult, Write},
+};
+
+use aes::Aes256;
+use hkdf::Hkdf;
+use hmac::HmacReset;
+use sha2::{Sha256, Sha512};
+use zeroize::Zeroizing;
+
+use self::encrypted_stream::{AesReader, AesWriter};
+
+pub(crate) type Aes256Ctr = ctr::Ctr128BE<Aes256>;
+
+/// KeyBuffer type that makes sure that the buffer is zeroed out before being
+/// dropped.
+pub(crate) type KeyBuffer = Zeroizing<Vec<u8>>;
+
+/// 16 byte random IV for the AES-CTR mode.
+pub(crate) const IV_SIZE: usize = 16;
+/// 32 byte or 256 bit encryption keys.
+pub(crate) const KEY_SIZE: usize = 32;
+/// 32 byte message authentication code since HMAC-SHA256 is used.
+pub(crate) const MAC_LENGTH: usize = 32;
+/// HKDF info, making the derived keys unique to the search index.
+pub(crate) const HKDF_INFO: &[u8] = b"matrix-sdk-search-encryption-key";
+
+/// Expand a high-entropy key, without any key stretching, into a 256 bit
+/// encryption key and a 256 bit MAC key:
+///
+/// ```text
+///     encryption_key, mac_key = HKDF(SHA512, key, info = "matrix-sdk-search-encryption-key", 512)
+/// ```
+pub(crate) fn derive_keys(key: &str) -> IoResult<(KeyBuffer, KeyBuffer)> {
+    if key.is_empty() {
+        return Err(IoError::other("empty key"));
+    }
+
+    let mut hkdf_result = Zeroizing::new([0u8; KEY_SIZE * 2]);
+    Hkdf::<Sha512>::new(None, key.as_bytes())
+        .expand(HKDF_INFO, &mut *hkdf_result)
+        .map_err(|e| IoError::other(format!("unable to expand the key: {e:?}")))?;
+    let (encryption_key, mac_key) = hkdf_result.split_at(KEY_SIZE);
+
+    Ok((Zeroizing::new(encryption_key.to_vec()), Zeroizing::new(mac_key.to_vec())))
+}
+
+/// Encrypts and authenticates whole files, in the format of
+/// [`EncryptedMmapDirectory`](encrypted_dir::EncryptedMmapDirectory): AES-CTR
+/// with a random IV, and an HMAC-SHA256 of the ciphertext at the end:
+///
+/// ```text
+///     file_data = (iv || ciphertext || mac)
+/// ```
+#[derive(Clone)]
+pub(crate) struct FileCipher {
+    encryption_key: KeyBuffer,
+    mac_key: KeyBuffer,
+}
+
+impl FileCipher {
+    /// Make a cipher from a high-entropy key, see [`derive_keys`].
+    pub(crate) fn new(key: &str) -> IoResult<Self> {
+        let (encryption_key, mac_key) = derive_keys(key)?;
+        Ok(Self { encryption_key, mac_key })
+    }
+
+    /// Encrypt and authenticate a file.
+    pub(crate) fn encrypt(&self, data: &[u8]) -> IoResult<Vec<u8>> {
+        let mut encrypted = Vec::with_capacity(data.len() + IV_SIZE + MAC_LENGTH);
+        let mut writer = AesWriter::<Aes256Ctr, HmacReset<Sha256>, _>::new(
+            &mut encrypted,
+            &self.encryption_key,
+            &self.mac_key,
+            IV_SIZE,
+        )?;
+        writer.write_all(data)?;
+        writer.finalize()?;
+        drop(writer);
+        Ok(encrypted)
+    }
+
+    /// Authenticate and decrypt a file; fails if it was encrypted with another
+    /// key or tampered with.
+    pub(crate) fn decrypt(&self, data: &[u8]) -> IoResult<Vec<u8>> {
+        let mut reader = AesReader::<Aes256Ctr, _>::new::<HmacReset<Sha256>>(
+            Cursor::new(data),
+            &self.encryption_key,
+            &self.mac_key,
+            IV_SIZE,
+            MAC_LENGTH,
+        )?;
+        let mut decrypted = Vec::with_capacity(data.len().saturating_sub(IV_SIZE + MAC_LENGTH));
+        reader.read_to_end(&mut decrypted)?;
+        Ok(decrypted)
+    }
+}
+
+impl fmt::Debug for FileCipher {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("FileCipher").finish_non_exhaustive()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::FileCipher;
+
+    #[test]
+    fn encrypt_and_decrypt_a_file() {
+        let cipher = FileCipher::new("a high-entropy key").unwrap();
+        let encrypted = cipher.encrypt(b"hello").unwrap();
+        assert_ne!(&encrypted[16..21], b"hello");
+        assert_eq!(cipher.decrypt(&encrypted).unwrap(), b"hello");
+
+        // Another key fails the MAC.
+        let other = FileCipher::new("another key").unwrap();
+        assert!(other.decrypt(&encrypted).is_err());
+
+        // So does tampering.
+        let mut tampered = encrypted.clone();
+        tampered[17] ^= 1;
+        assert!(cipher.decrypt(&tampered).is_err());
+
+        assert!(FileCipher::new("").is_err());
+    }
+}
