+
+/// Builder for a [`RoomIndex`] kept in memory and persisted through a
+/// [`SearchIndexFileStore`](crate::store::SearchIndexFileStore).
+pub struct PersistedRoomIndexBuilder {
+    room_id: OwnedRoomId,
+    files: Vec<IndexFile>,
+    key: Option<Zeroizing<String>>,
+}
+
+impl PersistedRoomIndexBuilder {
+    /// Encrypt the files with the given high-entropy key.
+    pub fn encrypted<K: Into<String>>(mut self, key: K) -> Self {
+        self.key = Some(Zeroizing::new(key.into()));
+        self
+    }
+
+    /// Build the [`RoomIndex`].
+    ///
+    /// Files that can't be read, e.g. because they were encrypted with another
+    /// key or in an older format, are dropped: the index starts empty, and the
+    /// next [`RoomIndex::take_file_changes`] deletes them from the store.
+    pub fn build(self) -> Result<RoomIndex, IndexError> {
+        let cipher = self.key.as_deref().map(|key| FileCipher::new(key)).transpose()?;
+        let schema = RoomMessageSchema::new();
+
+        let open = || -> Result<(Index, PersistedRamDirectory), IndexError> {
+            let files = self
+                .files
+                .iter()
+                .map(|file| {
+                    let data = match &cipher {
+                        Some(cipher) => cipher.decrypt(&file.data)?,
+                        None => file.data.clone(),
+                    };
+                    Ok::<_, IndexError>((file.name.clone(), data))
+                })
+                .collect::<Result<Vec<_>, _>>()?;
+            let directory = PersistedRamDirectory::from_files(files)?;
+            let index = Index::open_or_create(directory.clone(), schema.as_tantivy_schema())?;
+            Ok((index, directory))
+        };
+
+        let (index, directory) = match open() {
+            Ok(opened) => opened,
+            Err(err) if !self.files.is_empty() => {
+                // It can't tell a wrong key from other errors.
+                warn!(room_id = %self.room_id, "Recreating the search index: {err}");
+                let directory = PersistedRamDirectory::replacing(
+                    self.files.iter().map(|file| file.name.clone()),
+                );
+                let index = Index::open_or_create(directory.clone(), schema.as_tantivy_schema())?;
+                (index, directory)
+            }
+            Err(err) => return Err(err),
+        };
+
+        Ok(RoomIndex::new_persisted(index, schema, &self.room_id, directory, cipher))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::collections::HashMap;
+
+    use ruma::{event_id, room_id, user_id};
+
+    use super::RoomIndexBuilder;
+    use crate::{
+        index::{IndexableEvent, RoomIndex, RoomIndexOperation},
+        store::IndexFile,
+    };
+
+    fn add(body: &str, n: u8) -> RoomIndexOperation {
+        let event_id = format!("$event{n}:example.org").try_into().unwrap();
+        RoomIndexOperation::Add(IndexableEvent::new(
+            event_id,
+            event_id!("$original:example.org").to_owned(),
+            user_id!("@alice:example.org").to_owned(),
+            None,
+            body.to_owned(),
+        ))
+    }
+
+    /// A store of one room, kept as a map of files: what a
+    /// `SearchIndexFileStore` would hold. Returns the number of deletions.
+    fn save(store: &mut HashMap<String, Vec<u8>>, index: &RoomIndex) -> usize {
+        let changes = index.take_file_changes().expect("persisted").unwrap();
+        let deleted = changes.delete.len();
+        for name in changes.delete {
+            store.remove(&name);
+        }
+        for file in changes.put {
+            store.insert(file.name, file.data);
+        }
+        deleted
+    }
+
+    fn load(store: &HashMap<String, Vec<u8>>) -> Vec<IndexFile> {
+        store.iter().map(|(name, data)| IndexFile { name: name.clone(), data: data.clone() }).collect()
+    }
+
+    #[test]
+    fn persisted_index_survives_a_reload() {
+        let room_id = room_id!("!room:example.org");
+        let mut store = HashMap::new();
+
+        let mut index = RoomIndexBuilder::new_persisted(room_id, vec![]).encrypted("key").build().unwrap();
+        // Creating the index writes its meta.
+        save(&mut store, &index);
+        assert!(store.contains_key("meta.json"));
+
+        index.execute(add("hello world", 1)).unwrap();
+        save(&mut store, &index);
+        assert!(store.len() > 1, "segment files");
+        assert!(store.values().all(|data| !data.windows(5).any(|w| w == b"hello")), "encrypted");
+
+        // Many commits, so segments get merged: merged-away files are deleted.
+        // `bulk_execute` waits for the merges, which `execute` leaves to
+        // background threads on native.
+        let mut deleted = 0;
+        for n in 2..40 {
+            index.bulk_execute(vec![add("hello again", n)]).unwrap();
+            deleted += save(&mut store, &index);
+        }
+        assert!(deleted > 0, "merged-away segment files were deleted");
+        drop(index);
+
+        let index = RoomIndexBuilder::new_persisted(room_id, load(&store)).encrypted("key").build().unwrap();
+        assert_eq!(index.search("hello", 100, None).unwrap().len(), 39);
+        assert_eq!(index.search("world", 10, None).unwrap().len(), 1);
+        assert!(index.take_file_changes().unwrap().unwrap().is_empty(), "loading changes nothing");
+
+        // The store only holds what the index references, lock files excluded.
+        assert!(store.keys().all(|name| !name.ends_with(".lock")));
+        assert!(store.len() < 39 * 5, "segments were merged: {} files", store.len());
+    }
+
+    #[test]
+    fn persisted_index_is_recreated_with_another_key() {
+        let room_id = room_id!("!room:example.org");
+        let mut store = HashMap::new();
+
+        let mut index = RoomIndexBuilder::new_persisted(room_id, vec![]).encrypted("key").build().unwrap();
+        index.execute(add("hello", 1)).unwrap();
+        save(&mut store, &index);
+        // The old segment files; the meta files get rewritten under the same names.
+        let stale: Vec<_> = store
+            .keys()
+            .filter(|name| !name.ends_with(".json"))
+            .cloned()
+            .collect();
+        assert!(!stale.is_empty());
+        let old_meta = store["meta.json"].clone();
+
+        // Another key can't read the files: the index starts empty and the
+        // stale files get deleted on the next save.
+        let mut index = RoomIndexBuilder::new_persisted(room_id, load(&store)).encrypted("other").build().unwrap();
+        assert!(index.search("hello", 10, None).unwrap().is_empty());
+        index.execute(add("fresh", 2)).unwrap();
+        save(&mut store, &index);
+        assert!(stale.iter().all(|name| !store.contains_key(name)), "stale files deleted");
+        assert_ne!(store["meta.json"], old_meta, "meta rewritten");
+
+        // Unencrypted works the same way.
+        let index = RoomIndexBuilder::new_persisted(room_id, load(&store)).encrypted("other").build().unwrap();
+        assert_eq!(index.search("fresh", 10, None).unwrap().len(), 1);
+        let mut store = HashMap::new();
+        let mut index = RoomIndexBuilder::new_persisted(room_id, vec![]).build().unwrap();
+        index.execute(add("plain", 3)).unwrap();
+        save(&mut store, &index);
+        let index = RoomIndexBuilder::new_persisted(room_id, load(&store)).build().unwrap();
+        assert_eq!(index.search("plain", 10, None).unwrap().len(), 1);
+    }
+}
