+//! Where a persisted search index keeps its files.
+//!
+//! On platforms without a filesystem, like the web, a room's index is kept in
+//! memory and its files are saved through a [`SearchIndexFileStore`] after
+//! each commit, then loaded back from it when the index is next opened.
+
+use std::{error::Error, fmt};
+
+use async_trait::async_trait;
+use matrix_sdk_common::{SendOutsideWasm, SyncOutsideWasm};
+use ruma::RoomId;
+
+/// A file of a room's index, as stored: encrypted if the index is.
+#[derive(Clone)]
+pub struct IndexFile {
+    /// The file's name, unique within the room's index.
+    pub name: String,
+    /// The file's contents.
+    pub data: Vec<u8>,
+}
+
+impl fmt::Debug for IndexFile {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("IndexFile").field("name", &self.name).field("len", &self.data.len()).finish()
+    }
+}
+
+/// The files of a room's index that changed since they were last saved.
+#[derive(Clone, Debug, Default)]
+pub struct IndexFileChanges {
+    /// Files to write, replacing any with the same name.
+    pub put: Vec<IndexFile>,
+    /// Names of files to delete.
+    pub delete: Vec<String>,
+}
+
+impl IndexFileChanges {
+    /// Whether there is nothing to save.
+    pub fn is_empty(&self) -> bool {
+        self.put.is_empty() && self.delete.is_empty()
+    }
+}
+
+/// An error from a [`SearchIndexFileStore`].
+#[derive(Debug, thiserror::Error)]
+#[error(transparent)]
+pub struct SearchIndexStoreError(Box<dyn Error + Send + Sync>);
+
+impl SearchIndexStoreError {
+    /// Wrap a store's own error.
+    pub fn backend(error: impl Error + Send + Sync + 'static) -> Self {
+        Self(Box::new(error))
+    }
+}
+
+/// A store for the files of persisted room indexes, e.g. IndexedDB on the web.
+///
+/// Files are opaque: when the index is encrypted, they are encrypted before
+/// they get here.
+#[cfg_attr(target_family = "wasm", async_trait(?Send))]
+#[cfg_attr(not(target_family = "wasm"), async_trait)]
+pub trait SearchIndexFileStore: fmt::Debug + SendOutsideWasm + SyncOutsideWasm {
+    /// All the files of a room's index; empty if it has never been saved.
+    async fn load_room(&self, room_id: &RoomId) -> Result<Vec<IndexFile>, SearchIndexStoreError>;
+
+    /// Write and delete files of a room's index, atomically: either every
+    /// change is saved or none is, so a saved index is always consistent.
+    async fn save_room(
+        &self,
+        room_id: &RoomId,
+        changes: IndexFileChanges,
+    ) -> Result<(), SearchIndexStoreError>;
+
+    /// Delete every file of a room's index.
+    async fn delete_room(&self, room_id: &RoomId) -> Result<(), SearchIndexStoreError>;
+
+    /// Read a value kept alongside the indexes, e.g. a marker.
+    async fn get_value(&self, key: &str) -> Result<Option<Vec<u8>>, SearchIndexStoreError>;
+
+    /// Write a value kept alongside the indexes.
+    async fn set_value(&self, key: &str, value: Vec<u8>) -> Result<(), SearchIndexStoreError>;
+}
