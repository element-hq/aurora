new file mode 100644
index 000000000..f016accbf
--- /dev/null
+++ b/crates/matrix-sdk-search/src/index/persisted_dir.rs
@@ -0,0 +1,230 @@
+// Copyright 2026 The Matrix.org Foundation C.I.C.
+//
