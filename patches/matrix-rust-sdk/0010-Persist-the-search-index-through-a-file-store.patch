+// limitations under the License.
+
+//! A tantivy directory kept in memory, which remembers which files changed so
+//! they can be saved elsewhere.
+
+use std::{
+    collections::BTreeSet,
+    fmt, io,
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+
+use tantivy::directory::{
+    Directory, FileHandle, FileSlice, RamDirectory, WatchCallback, WatchHandle, WritePtr,
+    error::{DeleteError, OpenReadError, OpenWriteError},
+};
+
+/// The files written and deleted since the changes were last taken.
+#[derive(Default)]
+struct Changes {
+    written: BTreeSet<PathBuf>,
+    deleted: BTreeSet<PathBuf>,
+}
+
+/// A [`RamDirectory`] which tracks the files written and deleted, so that a
+/// [`SearchIndexFileStore`](crate::store::SearchIndexFileStore) can be kept up
+/// to date after each commit.
+///
+/// Tantivy's `Directory` is synchronous while stores typically aren't, so the
+/// directory doesn't save anything itself: the owner calls
+/// [`PersistedRamDirectory::take_changes`] after a commit and saves them.
+///
+/// Lock files are transient and never tracked.
+#[derive(Clone, Default)]
+pub(crate) struct PersistedRamDirectory {
+    ram: RamDirectory,
+    changes: Arc<Mutex<Changes>>,
+}
+
+impl PersistedRamDirectory {
+    /// A directory holding the given files, none of which counts as changed.
+    pub(crate) fn from_files(
+        files: impl IntoIterator<Item = (String, Vec<u8>)>,
+    ) -> io::Result<Self> {
+        let directory = Self::default();
+        for (name, data) in files {
+            directory.ram.atomic_write(Path::new(&name), &data)?;
+        }
+        Ok(directory)
+    }
+
+    /// An empty directory replacing stored files which couldn't be read: the
+    /// next changes taken delete them.
+    pub(crate) fn replacing(stale_files: impl IntoIterator<Item = String>) -> Self {
+        let directory = Self::default();
+        directory
+            .changes
+            .lock()
+            .unwrap()
+            .deleted
+            .extend(stale_files.into_iter().map(PathBuf::from));
+        directory
+    }
+
+    /// The files written, with their current contents, and the files deleted
+    /// since the last call.
+    pub(crate) fn take_changes(&self) -> io::Result<(Vec<(String, Vec<u8>)>, Vec<String>)> {
+        let Changes { written, deleted } = std::mem::take(&mut *self.changes.lock().unwrap());
+
+        let mut put = Vec::with_capacity(written.len());
+        for path in written {
+            match self.ram.open_read(&path) {
+                Ok(file) => put.push((name(&path), file.read_bytes()?.as_slice().to_vec())),
+                // Written then deleted, e.g. a segment merged away: it is in
+                // `deleted` already.
+                Err(OpenReadError::FileDoesNotExist(_)) => {}
+                Err(err) => return Err(io::Error::other(err)),
+            }
+        }
+
+        Ok((put, deleted.iter().map(|path| name(path)).collect()))
+    }
+
+    fn track_written(&self, path: &Path) {
+        if is_lock_file(path) {
+            return;
+        }
+        let mut changes = self.changes.lock().unwrap();
+        changes.deleted.remove(path);
+        changes.written.insert(path.to_path_buf());
+    }
+
+    fn track_deleted(&self, path: &Path) {
+        if is_lock_file(path) {
+            return;
+        }
+        let mut changes = self.changes.lock().unwrap();
+        changes.written.remove(path);
+        changes.deleted.insert(path.to_path_buf());
+    }
+}
+
+fn name(path: &Path) -> String {
+    path.to_string_lossy().into_owned()
+}
+
+/// Tantivy's lock files (`.tantivy-writer.lock`, `.tantivy-meta.lock`), which
+/// only exist while a lock is held.
+fn is_lock_file(path: &Path) -> bool {
+    path.extension().is_some_and(|extension| extension == "lock")
+}
+
+impl fmt::Debug for PersistedRamDirectory {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "PersistedRamDirectory")
+    }
+}
+
+impl Directory for PersistedRamDirectory {
+    fn get_file_handle(&self, path: &Path) -> Result<Arc<dyn FileHandle>, OpenReadError> {
+        self.ram.get_file_handle(path)
+    }
+
+    fn open_read(&self, path: &Path) -> Result<FileSlice, OpenReadError> {
+        self.ram.open_read(path)
+    }
+
+    fn delete(&self, path: &Path) -> Result<(), DeleteError> {
+        self.ram.delete(path)?;
+        self.track_deleted(path);
+        Ok(())
+    }
+
+    fn exists(&self, path: &Path) -> Result<bool, OpenReadError> {
+        self.ram.exists(path)
+    }
+
+    fn open_write(&self, path: &Path) -> Result<WritePtr, OpenWriteError> {
+        let writer = self.ram.open_write(path)?;
+        self.track_written(path);
+        Ok(writer)
+    }
+
+    fn atomic_read(&self, path: &Path) -> Result<Vec<u8>, OpenReadError> {
+        self.ram.atomic_read(path)
+    }
+
+    fn atomic_write(&self, path: &Path, data: &[u8]) -> io::Result<()> {
+        self.ram.atomic_write(path, data)?;
+        self.track_written(path);
+        Ok(())
+    }
+
+    fn sync_directory(&self) -> io::Result<()> {
+        self.ram.sync_directory()
+    }
+
+    fn watch(&self, watch_callback: WatchCallback) -> tantivy::Result<WatchHandle> {
+        self.ram.watch(watch_callback)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::{io::Write, path::Path};
+
+    use tantivy::directory::{Directory, TerminatingWrite};
+
+    use super::PersistedRamDirectory;
+
+    #[test]
+    fn changes_are_tracked_and_taken_once() {
+        let directory = PersistedRamDirectory::from_files([("old".to_owned(), b"old".to_vec())])
+            .unwrap();
+        assert!(directory.exists(Path::new("old")).unwrap());
+
+        // Loaded files aren't changes.
+        let (put, deleted) = directory.take_changes().unwrap();
+        assert!(put.is_empty() && deleted.is_empty());
+
+        directory.atomic_write(Path::new("meta.json"), b"{}").unwrap();
+        let mut writer = directory.open_write(Path::new("seg.idx")).unwrap();
+        writer.write_all(b"segment").unwrap();
+        writer.terminate().unwrap();
+        directory.delete(Path::new("old")).unwrap();
+
+        // Lock files are never tracked.
+        directory.atomic_write(Path::new(".tantivy-meta.lock"), b"").unwrap();
+        directory.delete(Path::new(".tantivy-meta.lock")).unwrap();
+
+        let (put, deleted) = directory.take_changes().unwrap();
+        assert_eq!(
+            put,
+            vec![("meta.json".to_owned(), b"{}".to_vec()), ("seg.idx".to_owned(), b"segment".to_vec())]
+        );
+        assert_eq!(deleted, vec!["old".to_owned()]);
+
+        // Taken once.
+        let (put, deleted) = directory.take_changes().unwrap();
+        assert!(put.is_empty() && deleted.is_empty());
+
+        // Written then deleted is just deleted.
+        directory.atomic_write(Path::new("tmp"), b"x").unwrap();
+        directory.delete(Path::new("tmp")).unwrap();
+        let (put, deleted) = directory.take_changes().unwrap();
+        assert!(put.is_empty());
+        assert_eq!(deleted, vec!["tmp".to_owned()]);
+    }
+
+    #[test]
+    fn replacing_deletes_the_stale_files() {
+        let directory = PersistedRamDirectory::replacing(["a".to_owned(), "b".to_owned()]);
+        assert!(!directory.exists(Path::new("a")).unwrap());
+        let (put, deleted) = directory.take_changes().unwrap();
+        assert!(put.is_empty());
+        assert_eq!(deleted, vec!["a".to_owned(), "b".to_owned()]);
+    }
+}
