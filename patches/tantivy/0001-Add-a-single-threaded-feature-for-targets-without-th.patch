+    /// Waits for all the indexing workers to finish indexing the documents
+    /// pending in the pipeline, and returns the first worker error if any.
+    ///
+    /// The pipeline's sender must have been dropped or replaced beforehand,
+    /// otherwise the workers never terminate.
+    fn join_workers(&mut self) -> crate::Result<()> {
+        #[cfg(not(feature = "single-threaded"))]
+        {
+            for join_handle in std::mem::take(&mut self.workers_join_handle) {
+                join_handle
+                    .join()
+                    .map_err(|e| TantivyError::ErrorInThread(format!("{e:?}")))??;
+            }
+        }
+        #[cfg(feature = "single-threaded")]
+        {
+            // The workers never got a thread of their own: run them now, on the
+            // current thread. The pipeline is closed, so each one terminates
+            // once it has indexed everything that was pending.
+            for worker in std::mem::take(&mut self.pending_workers) {
+                worker.run()?;
+            }
+        }
         Ok(())
     }
 
