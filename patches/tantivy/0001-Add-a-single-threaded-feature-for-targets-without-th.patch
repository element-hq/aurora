+/// Creates the pipeline through which documents are sent to the indexing workers.
+fn document_channel<D: Document>() -> (AddBatchSender<D>, AddBatchReceiver<D>) {
+    // Without worker threads nobody drains the pipeline until the next commit,
+    // so a bounded channel would block `add_document` forever once it is full.
+    #[cfg(feature = "single-threaded")]
+    {
+        crossbeam_channel::unbounded()
+    }
+    #[cfg(not(feature = "single-threaded"))]
+    {
+        crossbeam_channel::bounded(PIPELINE_MAX_SIZE_IN_DOCS)
+    }
+}
+
+/// An indexing worker pulls batches of documents off the pipeline and turns
+/// them into segments, until the pipeline is closed.
+///
+/// Normally each worker runs on its own thread. In `single-threaded` mode
+/// (no threads available, e.g. on wasm) the workers are instead run on the
+/// current thread once the pipeline is closed, i.e. when the `IndexWriter`
+/// prepares a commit.
+struct IndexingWorker<D: Document> {
+    document_receiver: AddBatchReceiver<D>,
+    index_writer_bomb: IndexWriterBomb<D>,
+    segment_updater: SegmentUpdater,
+    delete_cursor: DeleteCursor,
+    mem_budget: usize,
+    index: Index,
+}
+
+impl<D: Document> IndexingWorker<D> {
+    fn run(self) -> crate::Result<()> {
+        let IndexingWorker {
+            document_receiver,
+            index_writer_bomb,
+            segment_updater,
+            mut delete_cursor,
+            mem_budget,
+            index,
+        } = self;
+        loop {
+            let mut document_iterator = document_receiver
+                .clone()
+                .into_iter()
+                .filter(|batch| !batch.is_empty())
+                .peekable();
+
+            // The peeking here is to avoid creating a new segment's files
+            // if no document are available.
+            //
+            // This is a valid guarantee as the peeked document now belongs to
+            // our local iterator.
+            if let Some(batch) = document_iterator.peek() {
+                assert!(!batch.is_empty());
+                delete_cursor.skip_to(batch[0].opstamp);
+            } else {
+                // No more documents.
+                // It happens when there is a commit, or if the `IndexWriter`
+                // was dropped.
+                index_writer_bomb.defuse();
+                return Ok(());
+            }
+
+            index_documents(
+                mem_budget,
+                index.new_segment(),
+                &mut document_iterator,
+                &segment_updater,
+                delete_cursor.clone(),
+            )?;
+        }
+    }
+}
+
