+    /// Runs `job` on the current thread, followed by the merges it queued.
+    ///
+    /// A task that ends a merge is itself run from within a merge, so tasks
+    /// nest. Merges however are only queued (see `queue_merge`), and drained
+    /// here by the outermost call, iteratively: a long chain of merges would
+    /// otherwise recurse once per merge and overflow the stack.
+    #[cfg(feature = "single-threaded")]
+    fn run_inline(&self, job: impl FnOnce()) {
+        struct DepthGuard<'a>(&'a AtomicUsize);
+        impl Drop for DepthGuard<'_> {
+            fn drop(&mut self) {
+                self.0.fetch_sub(1, Ordering::Relaxed);
+            }
+        }
+        let depth = self.inline_depth.fetch_add(1, Ordering::Relaxed);
+        let _guard = DepthGuard(&self.inline_depth);
+        job();
+        if depth == 0 {
+            loop {
+                // The lock is released before running the merge, which queues
+                // further merges itself.
+                let next_merge = self.pending_merges.lock().unwrap().pop_front();
+                match next_merge {
+                    Some(merge_job) => merge_job(),
+                    None => break,
+                }
+            }
+        }
+    }
+
+    /// Queues a merge to run once the current task is done, or runs it right
+    /// away when no task is running. See `run_inline`.
+    #[cfg(feature = "single-threaded")]
+    fn queue_merge(&self, merge_job: impl FnOnce() + Send + 'static) {
+        if self.inline_depth.load(Ordering::Relaxed) == 0 {
+            self.run_inline(merge_job);
+        } else {
+            self.pending_merges.lock().unwrap().push_back(Box::new(merge_job));
+        }
+    }
