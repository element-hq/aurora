     }
 
-    fn list_callback(&self) -> Vec<WatchCallback> {
+    /// Lists the live callbacks, so that they can be called later with
+    /// [`WatchCallbackList::broadcast_callbacks`], e.g. outside of a lock.
+    pub(crate) fn list_callback(&self) -> Vec<WatchCallback> {
