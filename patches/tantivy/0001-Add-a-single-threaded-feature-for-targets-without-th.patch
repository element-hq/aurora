         let mut i = 0;
@@ -75,22 +77,36 @@ impl WatchCallbackList {
 
     /// Triggers all callbacks
     pub fn broadcast(&self) -> FutureResult<()> {
-        let callbacks = self.list_callback();
+        Self::broadcast_callbacks(self.list_callback())
+    }
+
+    /// Triggers the given callbacks, as listed by [`WatchCallbackList::list_callback`].
+    ///
+    /// In `single-threaded` mode the callbacks run on the current thread
+    /// before this returns, so the caller must not hold a lock they need.
+    pub(crate) fn broadcast_callbacks(callbacks: Vec<WatchCallback>) -> FutureResult<()> {
         let (result, sender) = FutureResult::create("One of the callback panicked.");
         if callbacks.is_empty() {
             let _ = sender.send(Ok(()));
             return result;
         }
-        let spawn_res = std::thread::Builder::new()
-            .name("watch-callbacks".to_string())
-            .spawn(move || {
-                for callback in callbacks {
-                    callback.call();
-                }
-                let _ = sender.send(Ok(()));
-            });
-        if let Err(err) = spawn_res {
-            error!("Failed to spawn thread to call watch callbacks. Cause: {err:?}");
+        let call_callbacks = move || {
+            for callback in callbacks {
+                callback.call();
+            }
+            let _ = sender.send(Ok(()));
+        };
+        // Without threads, the callbacks are called right away on the current thread.
+        #[cfg(feature = "single-threaded")]
+        call_callbacks();
+        #[cfg(not(feature = "single-threaded"))]
+        {
+            let spawn_res = std::thread::Builder::new()
+                .name("watch-callbacks".to_string())
+                .spawn(call_callbacks);
+            if let Err(err) = spawn_res {
+                error!("Failed to spawn thread to call watch callbacks. Cause: {err:?}");
+            }
         }
         result
     }
