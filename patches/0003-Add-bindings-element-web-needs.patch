+#[matrix_sdk_ffi_macros::export]
+impl Client {
+    /// Registers an account with a password, signing this client in to it
+    /// unless that is inhibited. Call it again with authentication data for
+    /// each stage the homeserver asks for.
+    pub async fn register(
+        &self,
+        username: Option<String>,
+        password: Option<String>,
+        initial_device_name: Option<String>,
+        auth_json: Option<String>,
+        inhibit_login: bool,
+    ) -> Result<UiaaOutcome, ClientError> {
+        let mut request = ruma::api::client::account::register::v3::Request::new();
+        request.username = username;
+        request.password = password;
+        request.initial_device_display_name = initial_device_name;
+        request.auth = parse_auth_data(auth_json)?;
+        request.inhibit_login = inhibit_login;
+        match self.inner.matrix_auth().register(request).await {
+            Ok(_) => Ok(UiaaOutcome::Done),
+            Err(error) => auth_required(error.as_uiaa_response()).ok_or_else(|| error.into()),
+        }
+    }
+
+    /// Whether a username is free to register and allowed by the homeserver.
+    pub async fn is_username_available(&self, username: String) -> Result<bool, ClientError> {
+        let request =
+            ruma::api::client::account::get_username_availability::v3::Request::new(username);
+        Ok(self.inner.send(request).await?.available)
+    }
+
+    /// Has the homeserver email a validation token to an address, for
+    /// registering with it, resetting the password of its account, or adding
+    /// it to this account. Returns the ID of the validation session.
+    pub async fn request_email_token(
+        &self,
+        purpose: EmailTokenPurpose,
+        client_secret: String,
+        email: String,
+        send_attempt: u32,
+        next_link: Option<String>,
+    ) -> Result<String, ClientError> {
+        use ruma::api::client::account::{
+            request_3pid_management_token_via_email, request_password_change_token_via_email,
+            request_registration_token_via_email,
+        };
+
+        let secret = ruma::OwnedClientSecret::try_from(client_secret)?;
+        let attempt = send_attempt.into();
+        let sid = match purpose {
+            EmailTokenPurpose::Registration => {
+                let mut request = request_registration_token_via_email::v3::Request::new(
+                    secret, email, attempt,
+                );
+                request.next_link = next_link;
+                self.inner.send(request).await?.sid
+            }
+            EmailTokenPurpose::PasswordReset => {
+                let mut request = request_password_change_token_via_email::v3::Request::new(
+                    secret, email, attempt,
+                );
+                request.next_link = next_link;
+                self.inner.send(request).await?.sid
+            }
+            EmailTokenPurpose::AddThreepid => {
+                let mut request = request_3pid_management_token_via_email::v3::Request::new(
+                    secret, email, attempt,
+                );
+                request.next_link = next_link;
+                self.inner.send(request).await?.sid
+            }
+        };
+        Ok(sid.to_string())
+    }
+
+    /// Has the homeserver text a validation token to a phone number, for
+    /// adding it to this account.
+    pub async fn request_msisdn_token(
+        &self,
+        client_secret: String,
+        country: String,
+        phone_number: String,
+        send_attempt: u32,
+    ) -> Result<MsisdnTokenSession, ClientError> {
+        let secret = ruma::OwnedClientSecret::try_from(client_secret)?;
+        let response = self
+            .inner
+            .account()
+            .request_3pid_msisdn_token(&secret, &country, &phone_number, send_attempt.into())
+            .await?;
+        Ok(MsisdnTokenSession { sid: response.sid.to_string(), submit_url: response.submit_url })
+    }
+
+    /// Adds a validated email address or phone number to the account.
+    pub async fn add_threepid(
+        &self,
+        client_secret: String,
+        sid: String,
+        auth_json: Option<String>,
+    ) -> Result<UiaaOutcome, ClientError> {
+        let secret = ruma::OwnedClientSecret::try_from(client_secret)?;
+        let sid = ruma::OwnedSessionId::try_from(sid)?;
+        let auth = parse_auth_data(auth_json)?;
+        match self.inner.account().add_3pid(&secret, &sid, auth).await {
+            Ok(_) => Ok(UiaaOutcome::Done),
+            Err(error) => auth_required(error.as_uiaa_response()).ok_or_else(|| error.into()),
+        }
+    }
+
+    /// Removes an email address (medium `email`) or phone number (`msisdn`)
+    /// from the account.
+    pub async fn delete_threepid(&self, medium: String, address: String) -> Result<(), ClientError> {
+        self.inner.account().delete_3pid(&address, medium.into(), None).await?;
+        Ok(())
+    }
+
+    /// Changes the password of an account: this one's, or that of whoever the
+    /// authentication data identifies (by a validated email address, to reset
+    /// a forgotten password).
+    pub async fn change_password_with_auth(
+        &self,
+        new_password: String,
+        auth_json: Option<String>,
+        logout_devices: bool,
+    ) -> Result<UiaaOutcome, ClientError> {
+        let mut request =
+            ruma::api::client::account::change_password::v3::Request::new(new_password);
+        request.auth = parse_auth_data(auth_json)?;
+        request.logout_devices = logout_devices;
+        match self.inner.send(request).await {
+            Ok(_) => Ok(UiaaOutcome::Done),
+            Err(error) => auth_required(error.as_uiaa_response()).ok_or_else(|| error.into()),
+        }
+    }
+
+    /// Deletes some of the user's devices, with whatever authentication the
+    /// homeserver wants for it.
+    pub async fn delete_devices_with_auth(
+        &self,
+        device_ids: Vec<String>,
+        auth_json: Option<String>,
+    ) -> Result<UiaaOutcome, ClientError> {
+        let devices: Vec<OwnedDeviceId> = device_ids.into_iter().map(Into::into).collect();
+        match self.inner.delete_devices(&devices, parse_auth_data(auth_json)?).await {
+            Ok(_) => Ok(UiaaOutcome::Done),
