+/// Told of events as their JSON.
+#[matrix_sdk_ffi_macros::export(callback_interface)]
+pub trait RawEventListener: SyncOutsideWasm + SendOutsideWasm {
+    /// An event arrived. `encrypted` says whether it was sent encrypted
