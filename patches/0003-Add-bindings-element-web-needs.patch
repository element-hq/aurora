+    /// which have them, other users can be made creators of the new room too.
+    pub async fn upgrade(
+        &self,
+        new_version: String,
+        additional_creators: Vec<String>,
+    ) -> Result<String, ClientError> {
+        let mut request = ruma::api::client::room::upgrade_room::v3::Request::new(
+            self.inner.room_id().to_owned(),
+            ruma::RoomVersionId::try_from(new_version.as_str())?,
+        );
+        request.additional_creators = additional_creators
+            .into_iter()
+            .map(ruma::UserId::parse)
+            .collect::<Result<_, _>>()?;
+        Ok(self.inner.client().send(request).await?.replacement_room.to_string())
+    }
