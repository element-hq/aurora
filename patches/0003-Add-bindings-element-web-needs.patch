+pub trait RoomEventJsonListener: SyncOutsideWasm + SendOutsideWasm {
+    /// An event arrived in a room, decrypted if it could be. `encrypted` says
+    /// whether it was sent encrypted.
+    fn on_event(&self, room_id: String, event_json: String, encrypted: bool);
+}
