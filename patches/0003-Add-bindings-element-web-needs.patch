+#[matrix_sdk_ffi_macros::export]
+impl Client {
+    /// Calls the listener with each timeline event that comes down sync, in
+    /// whatever room, for as long as the returned handle is kept.
+    pub fn observe_room_timeline_events(
+        &self,
+        listener: Box<dyn RoomEventJsonListener>,
+    ) -> Arc<TaskHandle> {
+        use matrix_sdk::deserialized_responses::EncryptionInfo;
+        use ruma::events::AnySyncTimelineEvent;
+
+        let listener: Arc<dyn RoomEventJsonListener> = listener.into();
+        let handle = self.inner.add_event_handler(
+            move |event: Raw<AnySyncTimelineEvent>,
+                  room: matrix_sdk::Room,
+                  encryption_info: Option<EncryptionInfo>| {
+                let listener = listener.clone();
+                async move {
+                    listener.on_event(
+                        room.room_id().to_string(),
+                        event.json().get().to_owned(),
+                        encryption_info.is_some(),
+                    )
+                }
+            },
+        );
+        let guard = self.inner.event_handler_drop_guard(handle);
+        Arc::new(TaskHandle::new(get_runtime_handle().spawn(async move {
+            let _guard = guard;
+            std::future::pending::<()>().await
+        })))
+    }
+}
