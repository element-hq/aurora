+#[matrix_sdk_ffi_macros::export]
+impl Room {
+    /// Upgrades the room to another version: the homeserver makes a new room
+    /// which replaces this one, and whose ID is returned.
+    pub async fn upgrade(&self, new_version: String) -> Result<String, ClientError> {
+        let request = ruma::api::client::room::upgrade_room::v3::Request::new(
+            self.inner.room_id().to_owned(),
+            ruma::RoomVersionId::try_from(new_version.as_str())?,
+        );
+        Ok(self.inner.client().send(request).await?.replacement_room.to_string())
+    }
+
+    /// Asks the homeserver for the events relating to an event of the room,
+    /// oldest first, as JSON (decrypted, if they can be): all of them, or only
+    /// those of a relation type (`m.replace`, say), or of a relation type and
+    /// an event type.
+    // A page of them: the first hundred or so, as the homeserver sees fit.
+    pub async fn relations_json(
+        &self,
+        event_id: String,
+        relation_type: Option<String>,
+        event_type: Option<String>,
+    ) -> Result<Vec<String>, ClientError> {
+        use matrix_sdk::room::{IncludeRelations, RelationsOptions};
+
+        let mut options = RelationsOptions::default();
+        options.dir = ruma::api::Direction::Forward;
+        options.include_relations = match (relation_type, event_type) {
+            (Some(relation), Some(event)) => {
+                IncludeRelations::RelationsOfTypeAndEventType(relation.into(), event.into())
+            }
+            (Some(relation), None) => IncludeRelations::RelationsOfType(relation.into()),
+            _ => IncludeRelations::AllRelations,
+        };
+        let relations = self.inner.relations(EventId::parse(event_id)?, options).await?;
+        Ok(relations.chunk.iter().map(|event| event.raw().json().get().to_owned()).collect())
+    }
+
+    /// The tags the user has given the room, as the JSON content of its
+    /// `m.tag` event: an object of tag names to what is known of each.
+    pub async fn tags_json(&self) -> Result<String, ClientError> {
+        Ok(serde_json::to_string(&self.inner.tags().await?.unwrap_or_default())?)
+    }
+
+    /// Gives the room a tag, placed among the others with it by an order from
+    /// 0 to 1 if one is given.
+    pub async fn set_tag(&self, tag: String, order: Option<f64>) -> Result<(), ClientError> {
+        let mut info = ruma::events::tag::TagInfo::new();
+        info.order = order;
+        self.inner.set_tag(tag.into(), info).await?;
+        Ok(())
+    }
+
+    /// Takes a tag off the room.
+    pub async fn remove_tag(&self, tag: String) -> Result<(), ClientError> {
+        self.inner.remove_tag(tag.into()).await?;
+        Ok(())
+    }
+}
