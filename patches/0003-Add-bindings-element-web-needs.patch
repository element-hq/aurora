+#[matrix_sdk_ffi_macros::export]
+impl Client {
+    /// Calls the listener with each global account data event that comes down
+    /// sync, whatever its type, for as long as the returned handle is kept.
+    pub fn observe_raw_account_data(&self, listener: Box<dyn RawEventListener>) -> Arc<TaskHandle> {
+        use ruma::events::AnyGlobalAccountDataEvent;
+
+        let listener: Arc<dyn RawEventListener> = listener.into();
+        let handle = self.inner.add_event_handler(move |event: Raw<AnyGlobalAccountDataEvent>| {
+            let listener = listener.clone();
+            async move { listener.on_event(event.json().get().to_owned(), false) }
+        });
+        let guard = self.inner.event_handler_drop_guard(handle);
+        Arc::new(TaskHandle::new(get_runtime_handle().spawn(async move {
+            let _guard = guard;
+            std::future::pending::<()>().await
+        })))
+    }
+
+    /// Calls the listener with each to-device event that comes down sync,
+    /// decrypted where it was encrypted, for as long as the returned handle
+    /// is kept.
+    pub fn observe_to_device_events(&self, listener: Box<dyn RawEventListener>) -> Arc<TaskHandle> {
+        use matrix_sdk::deserialized_responses::EncryptionInfo;
+        use ruma::events::AnyToDeviceEvent;
+
+        let listener: Arc<dyn RawEventListener> = listener.into();
+        let handle = self.inner.add_event_handler(
+            move |event: Raw<AnyToDeviceEvent>, encryption_info: Option<EncryptionInfo>| {
+                let listener = listener.clone();
+                async move {
+                    listener.on_event(event.json().get().to_owned(), encryption_info.is_some())
+                }
+            },
+        );
+        let guard = self.inner.event_handler_drop_guard(handle);
+        Arc::new(TaskHandle::new(get_runtime_handle().spawn(async move {
+            let _guard = guard;
+            std::future::pending::<()>().await
+        })))
+    }
+}
