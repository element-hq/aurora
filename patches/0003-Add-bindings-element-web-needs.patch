+#[matrix_sdk_ffi_macros::export]
+impl Room {
+    /// Asks the homeserver for the whole current state of the room, as JSON
+    /// events.
+    pub async fn fetch_state(&self) -> Result<Vec<String>, ClientError> {
+        let request = ruma::api::client::state::get_state_events::v3::Request::new(
+            self.inner.room_id().to_owned(),
+        );
+        let response = self.inner.client().send(request).await?;
+        Ok(response.room_state.into_iter().map(|event| event.json().get().to_owned()).collect())
+    }
+
+    /// Asks the homeserver for the content of one state event of the room, as
+    /// JSON, if the room has such an event.
+    pub async fn fetch_state_event_content(
+        &self,
+        event_type: String,
+        state_key: String,
+    ) -> Result<Option<String>, ClientError> {
+        let request = ruma::api::client::state::get_state_event_for_key::v3::Request::new(
+            self.inner.room_id().to_owned(),
+            event_type.into(),
+            state_key,
+        );
+        match self.inner.client().send(request).await {
+            Ok(response) => Ok(Some(response.event_or_content.get().to_owned())),
+            Err(error) if crate::client::is_not_found(&error) => Ok(None),
+            Err(error) => Err(error.into()),
+        }
+    }
+
+    /// Asks our homeserver for the aliases it has for the room.
+    pub async fn local_aliases(&self) -> Result<Vec<String>, ClientError> {
+        let request =
+            ruma::api::client::room::aliases::v3::Request::new(self.inner.room_id().to_owned());
+        let response = self.inner.client().send(request).await?;
+        Ok(response.aliases.into_iter().map(Into::into).collect())
+    }
+
+    /// Get the content of the event of the given type out of the room's
+    /// account data store.
+    ///
+    /// It will be returned as a JSON string.
+    pub async fn account_data(&self, event_type: String) -> Result<Option<String>, ClientError> {
+        let Some(event) = self.inner.account_data(event_type.into()).await? else {
+            return Ok(None);
+        };
+        Ok(event.get_field::<serde_json::Value>("content")?.map(|content| content.to_string()))
+    }
+
+    /// Set the given account data content for the given event type, for this
+    /// room.
+    ///
+    /// It should be supplied as a JSON string.
+    pub async fn set_account_data(
+        &self,
+        event_type: String,
+        content: String,
+    ) -> Result<(), ClientError> {
+        let content = matrix_sdk::ruma::serde::Raw::from_json_string(content)?;
+        self.inner.set_account_data_raw(event_type.into(), content).await?;
+        Ok(())
+    }
+
+    /// Asks the homeserver for the roots of the threads of the room which the
+    /// user has taken part in, most recently active first.
+    pub async fn participated_thread_ids(
+        &self,
+        limit: Option<u32>,
+    ) -> Result<Vec<String>, ClientError> {
+        let mut options = matrix_sdk::room::ListThreadsOptions::default();
+        options.include_threads =
+            ruma::api::client::threads::get_threads::v1::IncludeThreads::Participated;
+        options.limit = limit.map(Into::into);
+        let roots = self.inner.list_threads(options).await?;
+        Ok(roots.chunk.iter().filter_map(|event| Some(event.event_id()?.to_string())).collect())
+    }
+
+    /// Asks the homeserver for the event of the room closest to a time (in
+    /// milliseconds since the Unix epoch), looking forwards or backwards from
+    /// it.
+    pub async fn event_id_at_timestamp(
+        &self,
+        timestamp: u64,
+        forward: bool,
+    ) -> Result<String, ClientError> {
+        let timestamp = ruma::UInt::try_from(timestamp).map_err(ClientError::from_err)?;
+        let request = ruma::api::client::room::get_event_by_timestamp::v1::Request::new(
+            self.inner.room_id().to_owned(),
+            ruma::MilliSecondsSinceUnixEpoch(timestamp),
+            if forward { ruma::api::Direction::Forward } else { ruma::api::Direction::Backward },
+        );
+        Ok(self.inner.client().send(request).await?.event_id.to_string())
+    }
+
+    /// Asks the homeserver for an event of the room, as JSON (decrypted, if it
+    /// can be).
+    pub async fn fetch_event_json(&self, event_id: String) -> Result<String, ClientError> {
+        let event_id = EventId::parse(event_id)?;
+        let event = self.inner.event(&event_id, None).await?;
+        Ok(event.raw().json().get().to_owned())
+    }
+}
