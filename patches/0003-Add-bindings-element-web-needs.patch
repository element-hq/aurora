+/// Told when devices are first seen or change (a user signs in somewhere
+/// new, say, or a device becomes cross-signed).
+#[matrix_sdk_ffi_macros::export(callback_interface)]
+pub trait DevicesUpdatesListener: SyncOutsideWasm + SendOutsideWasm {
+    /// Devices of these users are new or have changed.
+    fn on_update(&self, user_ids: Vec<String>);
+}
+
+#[matrix_sdk_ffi_macros::export]
+impl Encryption {
+    /// Calls the listener whenever devices are first seen or change, for as
+    /// long as the returned handle is kept.
+    pub fn devices_updates_listener(
+        self: Arc<Self>,
+        listener: Box<dyn DevicesUpdatesListener>,
+    ) -> Arc<TaskHandle> {
+        Arc::new(TaskHandle::new(get_runtime_handle().spawn(async move {
+            let Ok(stream) = self.inner.devices_stream().await else { return };
+            let mut stream = std::pin::pin!(stream);
+            while let Some(updates) = stream.next().await {
+                let mut user_ids: Vec<String> =
+                    updates.new.keys().chain(updates.changed.keys()).map(ToString::to_string).collect();
+                user_ids.dedup();
+                listener.on_update(user_ids);
+            }
+        })))
+    }
+}
