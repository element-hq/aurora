+/// How a request which the homeserver may want interactive authentication for
+/// came out.
+#[derive(uniffi::Enum)]
+pub enum UiaaOutcome {
+    /// It was done.
+    Done,
+    /// The homeserver wants (more) authentication first. This is the JSON of
+    /// what it answered: the flows it accepts, their parameters, the session
+    /// to carry on with, the stages completed so far and, if the last attempt
+    /// at a stage failed, the error.
+    AuthRequired { uiaa_json: String },
+}
+
+/// Authentication data for a stage of interactive authentication, from its
+/// JSON.
+fn parse_auth_data(
+    auth_json: Option<String>,
+) -> Result<Option<ruma::api::client::uiaa::AuthData>, ClientError> {
+    Ok(auth_json.map(|json| serde_json::from_str(&json)).transpose()?)
+}
+
+/// The outcome of a request that failed, if it failed for want of
+/// authentication.
+fn auth_required(info: Option<&ruma::api::client::uiaa::UiaaInfo>) -> Option<UiaaOutcome> {
+    let uiaa_json = serde_json::to_string(info?).ok()?;
+    Some(UiaaOutcome::AuthRequired { uiaa_json })
+}
+
+/// What a token is requested by email for.
+#[derive(uniffi::Enum)]
+pub enum EmailTokenPurpose {
+    Registration,
+    PasswordReset,
+    AddThreepid,
+}
+
+/// A validation session for a phone number.
+#[derive(uniffi::Record)]
+pub struct MsisdnTokenSession {
+    pub sid: String,
+    /// Where to submit the token the user receives, if not to the identity
+    /// server.
+    pub submit_url: Option<String>,
+}
+
+fn rule_kind(kind: String) -> ruma::push::RuleKind {
+    ruma::push::RuleKind::from(kind)
+}
