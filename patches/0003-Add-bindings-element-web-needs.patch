+        let invite = ruma::api::client::membership::Invite3pid::from(
+            ruma::api::client::membership::Invite3pidInit {
+                id_server,
+                id_access_token,
+                medium: medium.into(),
+                address,
+            },
+        );
+        self.inner.invite_user_by_3pid(invite).await?;
+        Ok(())
+    }
+}
+
+/// A page of a room's history.
+#[derive(uniffi::Record)]
+pub struct MessagesPage {
+    /// The events, as JSON, decrypted where possible, in the order asked for.
+    pub events: Vec<String>,
+    /// Where to carry on from for the next page; none at the end of the room.
+    pub end: Option<String>,
+}
+
+#[matrix_sdk_ffi_macros::export]
+impl Room {
+    /// Asks the homeserver for a page of the room's events, from a pagination
+    /// token (or from the newest event, going backwards, without one). This
+    /// touches no timeline: it is for crawling history, to index it, say.
+    pub async fn messages_json(
+        &self,
+        from: Option<String>,
+        backwards: bool,
+        limit: u32,
+    ) -> Result<MessagesPage, ClientError> {
+        use matrix_sdk::room::MessagesOptions;
+
+        let mut options =
+            if backwards { MessagesOptions::backward() } else { MessagesOptions::forward() };
+        options.from = from;
+        options.limit = limit.into();
+        let messages = self.inner.messages(options).await?;
+        Ok(MessagesPage {
+            events: messages.chunk.iter().map(|e| e.raw().json().get().to_owned()).collect(),
+            end: messages.end,
+        })
+    }
+}
